# Nginx vhost for socket-test-backend
# App listens on PORT=8890 (see .env)

server {
    listen 80;
    listen [::]:80;
    server_name websocket.itip-demo.ucll.cloud; # change to your domain

    # Optional upload limit
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8890;

        # Preserve client/request metadata
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for Socket.IO / WebSocket upgrades
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Keep WebSocket connections stable
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}